{
  "name": "pix",
  "version": "1.5.0",
  "description": "PiX - Desktop GUI for Pi AI coding agent",
  "type": "module",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "npm run build:runtime && node scripts/link-workspace-deps.mjs && concurrently \"vite\" \"npm --prefix .. run watch:pix-runtime\" \"npm run dev:main\" \"wait-on http://localhost:5173 dist/main/main/index.js dist/main/main/preload.cjs && node scripts/watch-electron.mjs\"",
    "dev:main": "npm run build:preload && tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "build:renderer": "vite build",
    "build:preload": "tsc src/main/preload.ts --outDir dist/main --module CommonJS --target ES2022 --esModuleInterop --skipLibCheck --rootDir src && shx mv -f dist/main/main/preload.js dist/main/main/preload.cjs",
    "build:main": "npm run build:preload && tsc -p tsconfig.main.json",
    "build:runtime": "npm --prefix .. run build:pix-runtime",
    "build:desktop": "npm run build:main && npm run build:renderer",
    "build": "npm run build:runtime && node scripts/link-workspace-deps.mjs && npm run build:desktop",
    "start": "electron .",
    "test": "npm run test:renderer && npm run test:packaging",
    "test:renderer": "vitest run",
    "test:packaging": "node --test scripts/packaged-deps.test.mjs",
    "test:packaged-workflow": "node --test scripts/packaged-workflow.test.mjs",
    "package": "npm run build:runtime && node scripts/materialize-workspace-deps.mjs && node scripts/sync-nested-deps.mjs && npm run build:desktop && node scripts/stop-unpacked-app.mjs && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../packages/agent",
    "@earendil-works/pi-ai": "file:../packages/ai",
    "@earendil-works/pi-coding-agent": "file:../packages/coding-agent",
    "@earendil-works/pix-runtime": "file:../packages/pix-runtime",
    "@mdi/font": "^7.4.47",
    "@modelcontextprotocol/sdk": "1.29.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.9.0",
    "katex": "^0.18.9",
    "marked": "^12.0.0",
    "pi-mcp-adapter": "file:../packages/mcp-adapter",
    "pinia": "^2.1.0",
    "proper-lockfile": "4.1.2",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuetify": "^3.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "2.4.6",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "happy-dom": "18.0.1",
    "tsx": "4.22.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "3.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pix.app",
    "productName": "PiX",
    "publish": [
      {
        "provider": "github",
        "owner": "Sombrer0-1",
        "repo": "PiX"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/pix-runtime/package.json",
      "node_modules/@earendil-works/pix-runtime/dist/workflow/engine/**/*",
      "node_modules/@earendil-works/pix-runtime/dist/shared/workflow-types.js"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PiX",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
