{
	"name": "pi-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"packages/coding-agent/examples/extensions/with-deps",
		"packages/coding-agent/examples/extensions/custom-provider-anthropic",
		"packages/coding-agent/examples/extensions/custom-provider-gitlab-duo",
		"packages/coding-agent/examples/extensions/sandbox"
	],
	"scripts": {
		"clean": "npm run clean --workspaces",
		"build": "npm run build:pix-runtime",
		"build:pi": "npm run build -w packages/tui && npm run build:compile -w packages/ai && npm run build -w packages/agent && npm run build -w packages/coding-agent && npm run build -w packages/mcp-adapter",
		"build:pix-runtime": "npm run version:pix -- --check && npm run build:pi && npm run build -w packages/pix-runtime",
		"build:cli": "npm run build:pix-runtime && npm run build -w packages/pix-cli && npm rebuild @earendil-works/pix-cli --ignore-scripts",
		"dev:cli": "npm run build:pix-runtime && npm run dev -w packages/pix-cli --",
		"watch:pix-runtime": "npm run watch -w packages/pix-runtime",
		"check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:ts-imports && npm run check:shrinkwrap && tsgo --noEmit && npm run check:browser-smoke",
		"check:browser-smoke": "node scripts/check-browser-smoke.mjs",
		"check:pinned-deps": "node scripts/check-pinned-deps.mjs",
		"check:shrinkwrap": "node scripts/generate-coding-agent-shrinkwrap.mjs --check",
		"check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
		"profile:tui": "node scripts/profile-coding-agent-node.mjs --mode tui",
		"profile:rpc": "node scripts/profile-coding-agent-node.mjs --mode rpc",
		"test": "npm run test --workspaces --if-present && npm --prefix pix run test:packaging",
		"test:pix-runtime": "npm run build:cli && node scripts/test-pix-runtime.mjs",
		"version:patch": "node scripts/version-pi.mjs patch",
		"version:minor": "node scripts/version-pi.mjs minor",
		"version:major": "node scripts/version-pi.mjs major",
		"version:set": "node scripts/version-pi.mjs",
		"version:pix": "node scripts/version-pix.mjs",
		"prepublishOnly": "npm run clean && npm run build && npm run check",
		"publish": "npm run prepublishOnly && node scripts/publish.mjs",
		"publish:dry": "npm run prepublishOnly && node scripts/publish.mjs --dry-run",
		"release:local": "node scripts/local-release.mjs",
		"shrinkwrap:coding-agent": "node scripts/generate-coding-agent-shrinkwrap.mjs",
		"release:patch": "node scripts/release.mjs patch",
		"release:minor": "node scripts/release.mjs minor",
		"release:major": "node scripts/release.mjs major",
		"prepare": "husky"
	},
	"devDependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"esbuild": "0.28.0",
		"husky": "9.1.7",
		"jiti": "2.7.0",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"version": "0.0.3",
	"overrides": {
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	}
}
